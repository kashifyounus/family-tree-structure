# Optional default family website address (dev / first launch pre-fill only).
# Users can always change the saved address in Account → Shared online without rebuilding the APK.
# Local Android emulator: http://10.0.2.2:3000
# Physical device on same Wi‑Fi: http://YOUR_PC_LAN_IP:3000
# Production: https://your-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Drive backup (Android) — OAuth 2.0 Web client ID from Google Cloud Console
# Enable Google Drive API and add SHA-1 of your signing key to the Android OAuth client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
