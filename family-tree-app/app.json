{
  "expo": {
    "name": "Mughal's Family Tree",
    "slug": "mughals-family-tree",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mughalsfamilytree",
    "userInterfaceStyle": "automatic",
    "description": "Family genealogy — private archive on your phone or shared records on your family website.",
    "primaryColor": "#1B4332",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mughals.familytree"
    },
    "android": {
      "package": "com.mughals.familytree",
      "versionCode": 5,
      "label": "Mughal's Family Tree",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B4332"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "author": "Kashif Younus",
      "ownerEmail": "kashifyounus@mughals.local"
    }
  }
}
